  wheat: ["M12 21V5", "m12 8-3-3", "m12 12 3-3", "m12 16-3-3", "m12 19 3-3"],
  jar: ["M7 7h10l1 3v10H6V10Z", "M8 3h8v4H8Z", "M9 13h6"],
