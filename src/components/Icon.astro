  nut: ["M12 3c5 0 8 4 8 9s-3 9-8 9-8-4-8-9 3-9 8-9Z", "M8 8c2 1 6 1 8 0"],
  diamond: ["m12 3 8 9-8 9-8-9Z"],
  hazelnut: ["M12 5c5 0 8 4 8 8a8 8 0 0 1-16 0c0-4 3-8 8-8Z", "M8 6c1-2 3-3 5-3"],
  leaf: ["M20 4C10 4 5 8 5 14c0 4 3 6 7 6 6 0 8-7 8-16Z", "M5 20c3-5 7-8 12-11"],
