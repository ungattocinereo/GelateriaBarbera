---
import { allergenInfo, categoryLabels, defaultLocale, flavors, locales, type Category } from "@data/flavors";
import "@fortawesome/fontawesome-free/css/all.min.css";
import socialPreviewImage from "../../images/stracciatella.png";
import "../styles/global.css";

const locale = defaultLocale;
const siteTitle = "LaB Ingredienti e Allergeni | Laboratorio del Gelato Praiano";
const siteDescription = "Consulta ingredienti e allergeni dei gelati artigianali, sorbetti, coni ed extra di LaB Laboratorio del Gelato a Praiano.";
const socialDescription = "Scegli il tuo gelato LaB a Praiano con schede chiare su ingredienti, allergeni e possibili tracce.";
const socialImageAlt = "Gelato stracciatella di LaB Laboratorio del Gelato a Praiano";
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url).toString();
const socialImageUrl = new URL(socialPreviewImage.src, Astro.site ?? Astro.url).toString();
const socialImageType = socialPreviewImage.format === "jpg" ? "image/jpeg" : `image/${socialPreviewImage.format}`;
const socialImageWidth = socialPreviewImage.width.toString();
const socialImageHeight = socialPreviewImage.height.toString();
const counts: Record<Category | "all", number> = {
  all: flavors.length,
  gelato: flavors.filter((flavor) => flavor.category === "gelato").length,
  sorbetto: flavors.filter((flavor) => flavor.category === "sorbetto").length,
  extra: flavors.filter((flavor) => flavor.category === "extra").length
};
const categories: (Category | "all")[] = ["all", "gelato", "sorbetto", "extra"];
const flavorImageModules = import.meta.glob("../../images/*.{png,jpg,jpeg,webp}", {
  eager: true,
  query: "?url",
  import: "default"
}) as Record<string, string>;
const flavorImageOverrides: Record<string, string | undefined> = {
  "sciroppo-zucchero": flavorImageModules[`../../images/white-scoop.png`]
};
const flavorImage = (id: string) =>
  flavorImageOverrides[id] ??
  flavorImageModules[`../../images/${id}.png`] ??
  flavorImageModules[`../../images/${id}.jpg`] ??
  flavorImageModules[`../../images/${id}.jpeg`] ??
  flavorImageModules[`../../images/${id}.webp`] ??
  "/gelato-texture.png";
const flavorsWithImages = flavors.map((flavor) => ({
  ...flavor,
  imageSrc: flavorImage(flavor.id)
}));
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{siteTitle}</title>
    <meta name="description" content={siteDescription} />
    <meta name="robots" content="index, follow" />
    <meta name="googlebot" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="theme-color" content="#0f0733" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="LaB Laboratorio del Gelato" />
    <meta property="og:locale" content="it_IT" />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={socialDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:secure_url" content={socialImageUrl} />
    <meta property="og:image:type" content={socialImageType} />
    <meta property="og:image:width" content={socialImageWidth} />
    <meta property="og:image:height" content={socialImageHeight} />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={siteTitle} />
    <meta name="twitter:description" content={socialDescription} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/" aria-label="LaB Laboratorio del Gelato">
        <img src="/logo-new.png" alt="LaB Laboratorio del Gelato" />
        <span>
          <strong>Ingredienti e allergeni</strong>
          <small>Praiano, Amalfi Coast</small>
        </span>
      </a>

      <nav class="language-switcher" aria-label="Lingue disponibili">
        {
          locales.map((item) => (
            <button class:list={["language-button", { active: item.active }]} disabled={!item.active} title={item.label}>
              <span>{item.short}</span>
            </button>
          ))
        }
      </nav>
    </header>

    <main>
      <section class="hero" aria-labelledby="page-title">
        <div class="hero-copy">
          <h1 id="page-title">Ingredienti chiari per scegliere il tuo gelato.</h1>
          <p>
            Consulta ingredienti e allergeni di gelati, sorbetti, coni e extra. Le indicazioni
            seguono il documento ingredienti per il pubblico.
          </p>
          <div class="hero-actions" aria-label="Azioni principali">
            <a class="primary-action" href="#flavors">Consulta gusti</a>
            <a class="ghost-action" href="#filters">Filtra categorie</a>
          </div>
          <div class="hero-proof" aria-label="Sintesi catalogo">
            <span>
              <strong>{counts.all}</strong>
              gusti e extra
            </span>
            <span>
              <strong>{counts.gelato}</strong>
              gelati
            </span>
            <span>
              <strong>{counts.sorbetto}</strong>
              sorbetti
            </span>
          </div>
        </div>
        <div class="hero-mark" aria-label="LaB Laboratorio del Gelato">
          <img class="hero-logo" src="/logo-new.png" alt="LaB Laboratorio del Gelato" width="420" height="420" />
        </div>
      </section>

      <section class="toolbar" id="filters" aria-label="Filtro categorie">
        <div class="category-tabs" role="tablist" aria-label="Categorie">
          {
            categories.map((category) => (
              <button
                class:list={["category-tab", { active: category === "all" }]}
                type="button"
                data-filter={category}
                aria-pressed={category === "all" ? "true" : "false"}
              >
                <span>{categoryLabels[category][locale]}</span>
                <small>{counts[category]}</small>
              </button>
            ))
          }
        </div>
        <label class="search-field">
          <span class="sr-only">Cerca gusto o ingrediente</span>
          <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
          <input type="search" placeholder="Cerca gusto o ingrediente..." autocomplete="off" />
        </label>
      </section>

      <section class="flavor-grid" id="flavors" aria-label="Lista ingredienti e allergeni">
        {
          flavorsWithImages.map((flavor) => (
            <article
              class={`flavor-card theme-${flavor.theme}`}
              data-category={flavor.category}
              data-card
              data-search={`${flavor.name[locale]} ${flavor.ingredients[locale].join(" ")} ${flavor.allergens
                .map((allergen) => allergenInfo[allergen.key].label[locale])
                .join(" ")}`.toLocaleLowerCase("it")}
            >
              <button
                class="flavor-card-trigger"
                type="button"
                data-dialog-trigger
                aria-label={`Apri scheda dettagliata di ${flavor.name[locale]}`}
                aria-haspopup="dialog"
                aria-controls={`dialog-${flavor.id}`}
              ></button>

              <span class="ingredient-count-badge" aria-label={`${flavor.ingredients[locale].length} ingredienti`}>
                <strong>{flavor.ingredients[locale].length}</strong>
              </span>

              <div class="flavor-topline">
                <div class="flavor-photo">
                  <img
                    src={flavor.imageSrc}
                    alt={`Foto di ${flavor.name[locale]}`}
                    loading="lazy"
                    width="420"
                    height="320"
                    decoding="async"
                  />
                </div>
                <div>
                  <p class="category-label">{categoryLabels[flavor.category][locale]}</p>
                  <h2>{flavor.name[locale]}</h2>
                </div>
              </div>

              {
                flavor.allergens.length > 0 ? (
                  <div class="allergens" aria-label={`Allergeni per ${flavor.name[locale]}`}>
                    <h3>Allergeni</h3>
                    <div class="allergen-list">
                      {flavor.allergens.map((allergen) => {
                        const info = allergenInfo[allergen.key];
                        return (
                          <span class:list={["allergen-chip", allergen.presence]} title={info.description[locale]}>
                            <span class="allergen-icon" aria-hidden="true">
                              <i class={info.icon}></i>
                            </span>
                            <span>
                              <strong>{info.label[locale]}</strong>
                              <small>{allergen.presence === "contains" ? "Contiene" : "Possibile presenza"}</small>
                              {allergen.note ? <em>{allergen.note[locale]}</em> : null}
                            </span>
                          </span>
                        );
                      })}
                    </div>
                  </div>
                ) : null
              }

              <dialog
                class:list={["flavor-dialog", `theme-${flavor.theme}`]}
                id={`dialog-${flavor.id}`}
                aria-labelledby={`dialog-title-${flavor.id}`}
              >
                <div class="flavor-dialog-card">
                  <button
                    class="dialog-close"
                    type="button"
                    data-dialog-close
                    aria-label={`Chiudi scheda dettagliata di ${flavor.name[locale]}`}
                  >
                    <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                  </button>

                  <div class="dialog-layout">
                    <div class="dialog-photo">
                      <img
                        src={flavor.imageSrc}
                        alt={`Foto di ${flavor.name[locale]}`}
                        loading="lazy"
                        width="640"
                        height="760"
                        decoding="async"
                      />
                    </div>

                    <div class="dialog-content">
                      <div class="dialog-topline">
                        <div>
                          <p class="category-label">{categoryLabels[flavor.category][locale]}</p>
                          <h2 id={`dialog-title-${flavor.id}`}>{flavor.name[locale]}</h2>
                        </div>
                      </div>

                      <div class:list={["dialog-facts", { "single-fact": flavor.allergens.length === 0 }]}>
                        <span>
                          <i class="fa-solid fa-list-check" aria-hidden="true"></i>
                          <strong>{flavor.ingredients[locale].length}</strong>
                          <small>ingredienti</small>
                        </span>
                        {
                          flavor.allergens.length > 0 ? (
                            <span>
                              <i class="fa-regular fa-file-lines" aria-hidden="true"></i>
                              <strong>{flavor.allergens.length}</strong>
                              <small>allergeni indicati</small>
                            </span>
                          ) : null
                        }
                      </div>

                      <div class="dialog-detail-grid">
                        <div class="detail-section">
                          <h3>Ingredienti completi</h3>
                          <ul class="ingredient-list">
                            {flavor.ingredients[locale].map((ingredient) => <li>{ingredient}</li>)}
                          </ul>
                        </div>

                        {
                          flavor.allergens.length > 0 ? (
                            <div class="detail-section">
                              <h3>Allergeni completi</h3>
                              <ul class="detail-allergen-list">
                                {flavor.allergens.map((allergen) => {
                                  const info = allergenInfo[allergen.key];
                                  return (
                                    <li class:list={["detail-allergen", allergen.presence]}>
                                      <span class="allergen-icon" aria-hidden="true">
                                        <i class={info.icon}></i>
                                      </span>
                                      <span>
                                        <strong>{info.label[locale]}</strong>
                                        <small>
                                          {allergen.presence === "contains" ? "Contiene" : "Possibile presenza"}
                                          {allergen.note ? ` · ${allergen.note[locale]}` : ""}
                                        </small>
                                      </span>
                                    </li>
                                  );
                                })}
                              </ul>
                            </div>
                          ) : null
                        }
                      </div>
                    </div>
                  </div>
                </div>
              </dialog>
            </article>
          ))
        }
      </section>
    </main>

    <footer class="site-footer">
      <p>LaB Laboratorio del Gelato · Praiano</p>
      <p>Versione italiana. Traduzioni in preparazione: English, 中文, Français.</p>
    </footer>

    <script>
      const tabs = document.querySelectorAll("[data-filter]");
      const cards = document.querySelectorAll("[data-category]");
      const search = document.querySelector<HTMLInputElement>(".search-field input");
      let activeFilter = "all";

      const closeDialog = (dialog: HTMLDialogElement | null) => {
        if (!dialog?.open) {
          return;
        }

        if (typeof dialog.close === "function") {
          dialog.close();
        } else {
          dialog.removeAttribute("open");
        }
      };

      const updateCards = () => {
        const query = search?.value.trim().toLocaleLowerCase("it") ?? "";

        cards.forEach((card) => {
          const matchesCategory = activeFilter === "all" || card.getAttribute("data-category") === activeFilter;
          const matchesSearch = !query || card.getAttribute("data-search")?.includes(query);
          const isVisible = Boolean(matchesCategory && matchesSearch);

          card.classList.toggle("is-hidden", !isVisible);
          if (!isVisible) {
            closeDialog(card.querySelector<HTMLDialogElement>(".flavor-dialog"));
          }
        });
      };

      tabs.forEach((tab) => {
        tab.addEventListener("click", () => {
          activeFilter = tab.getAttribute("data-filter") ?? "all";

          tabs.forEach((item) => {
            const active = item === tab;
            item.classList.toggle("active", active);
            item.setAttribute("aria-pressed", active ? "true" : "false");
          });

          updateCards();
        });
      });

      search?.addEventListener("input", updateCards);

      cards.forEach((card) => {
        const trigger = card.querySelector<HTMLButtonElement>("[data-dialog-trigger]");
        const dialogId = trigger?.getAttribute("aria-controls");
        const dialog = dialogId ? (document.getElementById(dialogId) as HTMLDialogElement | null) : null;
        const closeButton = dialog?.querySelector<HTMLButtonElement>("[data-dialog-close]");

        trigger?.addEventListener("click", () => {
          if (!dialog) {
            return;
          }

          if (typeof dialog.showModal === "function") {
            dialog.showModal();
          } else {
            dialog.setAttribute("open", "");
          }
        });

        closeButton?.addEventListener("click", () => closeDialog(dialog));

        dialog?.addEventListener("click", (event) => {
          if (event.target === dialog) {
            closeDialog(dialog);
          }
        });
      });
    </script>
  </body>
</html>
