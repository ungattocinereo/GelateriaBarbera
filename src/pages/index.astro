---
import {
  allergenInfo,
  allergenPresenceLabels,
  categoryLabels,
  defaultLocale,
  flavors,
  locales,
  uiCopy,
  type Category,
  type Locale
} from "@data/flavors";
import Icon from "../components/Icon.astro";
import { Image, Picture, getImage } from "astro:assets";
import heroTextureImage from "../../gelato-texture.png";
import logoImage from "../../logo-new.png";
import socialPreviewImage from "../../images/stracciatella.png";
import "../styles/global.css";

const locale = (Astro.props.locale ?? defaultLocale) as Locale;
const copy = uiCopy[locale];
const currentLocale = locales.find((item) => item.code === locale) ?? locales[0];
const searchLocale = locale === "zh" ? "zh-Hans-CN" : locale;
const siteTitle = copy.siteTitle;
const siteDescription = copy.siteDescription;
const socialDescription = copy.socialDescription;
const socialImageAlt = copy.socialImageAlt;
const canonicalUrl = new URL(currentLocale.path, Astro.site ?? Astro.url).toString();
const socialPreview = await getImage({
  src: socialPreviewImage,
  width: 1024,
  format: "jpg",
  quality: 78
});
const socialImageUrl = new URL(socialPreview.src, Astro.site ?? Astro.url).toString();
const socialImageType = "image/jpeg";
const socialImageWidth = String(socialPreview.attributes.width);
const socialImageHeight = String(socialPreview.attributes.height);
const counts: Record<Category | "all", number> = {
  all: flavors.length,
  gelato: flavors.filter((flavor) => flavor.category === "gelato").length,
  sorbetto: flavors.filter((flavor) => flavor.category === "sorbetto").length,
  extra: flavors.filter((flavor) => flavor.category === "extra").length
};
const categories: (Category | "all")[] = ["all", "gelato", "sorbetto", "extra"];
const flavorImageModules = import.meta.glob("../../images/*.{png,jpg,jpeg,webp}", {
  eager: true,
  import: "default"
}) as Record<string, ImageMetadata>;
const flavorImageOverrides: Record<string, ImageMetadata | undefined> = {
  "sciroppo-zucchero": flavorImageModules[`../../images/white-scoop.png`],
  "vaniglia": flavorImageModules[`../../images/crema-vaniglia.png`]
};
const flavorImage = (id: string) =>
  flavorImageOverrides[id] ??
  flavorImageModules[`../../images/${id}.png`] ??
  flavorImageModules[`../../images/${id}.jpg`] ??
  flavorImageModules[`../../images/${id}.jpeg`] ??
  flavorImageModules[`../../images/${id}.webp`] ??
  heroTextureImage;
const flavorsWithImages = await Promise.all(
  flavors.map(async (flavor) => {
    const imageSrc = flavorImage(flavor.id);
    const dialogImage = await getImage({
      src: imageSrc,
      width: 640,
      format: "webp",
      quality: 78
    });

    return {
      ...flavor,
      imageSrc,
      dialogImage
    };
  })
);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{siteTitle}</title>
    <meta name="description" content={siteDescription} />
    <meta name="robots" content="index, follow" />
    <meta name="googlebot" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="canonical" href={canonicalUrl} />
    {locales.map((item) => <link rel="alternate" hreflang={item.code} href={new URL(item.path, Astro.site ?? Astro.url).toString()} />)}
    <link rel="alternate" hreflang="x-default" href={new URL("/", Astro.site ?? Astro.url).toString()} />
    <meta name="theme-color" content="#0f0733" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="LaB Laboratorio del Gelato" />
    <meta property="og:locale" content={currentLocale.ogLocale} />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={socialDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:secure_url" content={socialImageUrl} />
    <meta property="og:image:type" content={socialImageType} />
    <meta property="og:image:width" content={socialImageWidth} />
    <meta property="og:image:height" content={socialImageHeight} />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={siteTitle} />
    <meta name="twitter:description" content={socialDescription} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={currentLocale.path} aria-label="LaB Laboratorio del Gelato">
        <Image src={logoImage} alt="LaB Laboratorio del Gelato" width={64} format="webp" quality={82} />
        <span>
          <strong>{copy.brandTitle}</strong>
          <small>{copy.brandSubtitle}</small>
        </span>
      </a>

      <nav class="language-switcher" aria-label={copy.languageNavLabel}>
        {
          locales.map((item) => (
            <a
              class:list={["language-button", { active: item.code === locale }]}
              href={item.path}
              title={item.label}
              lang={item.code}
              aria-current={item.code === locale ? "page" : undefined}
            >
              <span class:list={["language-flag", item.flagClass]} aria-hidden="true"></span>
              <span class="language-code">{item.short}</span>
            </a>
          ))
        }
      </nav>
    </header>

    <main>
      <section class="hero" aria-labelledby="page-title">
        <Image
          src={heroTextureImage}
          alt=""
          class="hero-background"
          width={1600}
          format="webp"
          quality={76}
          loading="eager"
          fetchpriority="high"
          aria-hidden="true"
        />
        <div class="hero-copy">
          <h1 id="page-title">{copy.heroTitle}</h1>
          <p>{copy.heroIntro}</p>
          <div class="hero-actions" aria-label={copy.mainActionsLabel}>
            <a class="primary-action" href="#flavors">{copy.primaryAction}</a>
            <a class="ghost-action" href="#filters">{copy.ghostAction}</a>
          </div>
          <div class="hero-proof" aria-label={copy.heroProofLabel}>
            <span>
              <strong>{counts.all}</strong>
              {copy.allCountLabel}
            </span>
            <span>
              <strong>{counts.gelato}</strong>
              {copy.gelatoCountLabel}
            </span>
            <span>
              <strong>{counts.sorbetto}</strong>
              {copy.sorbettoCountLabel}
            </span>
          </div>
        </div>
        <div class="hero-mark" aria-label="LaB Laboratorio del Gelato">
          <Image
            class="hero-logo"
            src={logoImage}
            alt="LaB Laboratorio del Gelato"
            width={420}
            format="webp"
            quality={82}
            loading="eager"
          />
        </div>
      </section>

      <section class="toolbar" id="filters" aria-label={copy.filterSectionLabel}>
        <div class="category-tabs" role="tablist" aria-label={copy.categoryTabsLabel}>
          {
            categories.map((category) => (
              <button
                class:list={["category-tab", { active: category === "all" }]}
                type="button"
                data-filter={category}
                aria-pressed={category === "all" ? "true" : "false"}
              >
                <span>{categoryLabels[category][locale]}</span>
                <small>{counts[category]}</small>
              </button>
            ))
          }
        </div>
        <label class="search-field">
          <span class="sr-only">{copy.searchLabel}</span>
          <Icon name="search" />
          <input type="search" placeholder={copy.searchPlaceholder} autocomplete="off" />
        </label>
      </section>

      <section class="flavor-grid" id="flavors" aria-label={copy.flavorGridLabel}>
        {
          flavorsWithImages.map((flavor) => (
            <article
              class={`flavor-card theme-${flavor.theme}`}
              data-category={flavor.category}
              data-card
              data-search={`${flavor.name[locale]} ${flavor.ingredients[locale].join(" ")} ${flavor.allergens
                .map((allergen) => allergenInfo[allergen.key].label[locale])
                .join(" ")}`.toLocaleLowerCase(searchLocale)}
            >
              <button
                class="flavor-card-trigger"
                type="button"
                data-dialog-trigger
                aria-label={copy.openFlavor(flavor.name[locale])}
                aria-haspopup="dialog"
                aria-controls={`dialog-${flavor.id}`}
              ></button>

              <span class="ingredient-count-badge" aria-label={copy.ingredientCountLabel(flavor.ingredients[locale].length)}>
                <strong>{flavor.ingredients[locale].length}</strong>
              </span>

              <div class="flavor-topline">
                <div class="flavor-photo">
                  <Picture
                    src={flavor.imageSrc}
                    alt={copy.photoAlt(flavor.name[locale])}
                    formats={["avif"]}
                    fallbackFormat="webp"
                    widths={[240, 360, 420]}
                    sizes="(max-width: 620px) calc(50vw - 24px), (max-width: 1100px) calc(33vw - 24px), 320px"
                    quality={76}
                    loading="lazy"
                    decoding="async"
                  />
                </div>
                <div>
                  <p class="category-label">{categoryLabels[flavor.category][locale]}</p>
                  <h2>{flavor.name[locale]}</h2>
                </div>
              </div>

              {
                flavor.allergens.length > 0 ? (
                  <div class="allergens" aria-label={copy.allergensFor(flavor.name[locale])}>
                    <h3>{copy.allergensHeading}</h3>
                    <div class="allergen-list">
                      {flavor.allergens.map((allergen) => {
                        const info = allergenInfo[allergen.key];
                        return (
                          <span class:list={["allergen-chip", allergen.presence]} title={info.description[locale]}>
                            <span class="allergen-icon" aria-hidden="true">
                              <Icon name={info.icon} />
                            </span>
                            <span>
                              <strong>{info.label[locale]}</strong>
                              <small>{allergenPresenceLabels[allergen.presence][locale]}</small>
                              {allergen.note ? <em>{allergen.note[locale]}</em> : null}
                            </span>
                          </span>
                        );
                      })}
                    </div>
                  </div>
                ) : null
              }

              <dialog
                class:list={["flavor-dialog", `theme-${flavor.theme}`]}
                id={`dialog-${flavor.id}`}
                aria-labelledby={`dialog-title-${flavor.id}`}
              >
                <div class="flavor-dialog-card">
                  <button
                    class="dialog-close"
                    type="button"
                    data-dialog-close
                    aria-label={copy.closeFlavor(flavor.name[locale])}
                  >
                    <Icon name="close" />
                  </button>

                  <div class="dialog-layout">
                    <div class="dialog-photo">
                      <img
                        data-dialog-src={flavor.dialogImage.src}
                        alt={copy.photoAlt(flavor.name[locale])}
                        width={flavor.dialogImage.attributes.width}
                        height={flavor.dialogImage.attributes.height}
                        decoding="async"
                      />
                    </div>

                    <div class="dialog-content">
                      <div class="dialog-topline">
                        <div>
                          <p class="category-label">{categoryLabels[flavor.category][locale]}</p>
                          <h2 id={`dialog-title-${flavor.id}`}>{flavor.name[locale]}</h2>
                        </div>
                      </div>

                      <div class:list={["dialog-facts", { "single-fact": flavor.allergens.length === 0 }]}>
                        <span>
                          <Icon name="list" />
                          <strong>{flavor.ingredients[locale].length}</strong>
                          <small>{copy.ingredientFactLabel}</small>
                        </span>
                        {
                          flavor.allergens.length > 0 ? (
                            <span>
                              <Icon name="file" />
                              <strong>{flavor.allergens.length}</strong>
                              <small>{copy.allergenFactLabel}</small>
                            </span>
                          ) : null
                        }
                      </div>

                      <div class="dialog-detail-grid">
                        <div class="detail-section">
                          <h3>{copy.fullIngredientsHeading}</h3>
                          <ul class="ingredient-list">
                            {flavor.ingredients[locale].map((ingredient) => <li>{ingredient}</li>)}
                          </ul>
                        </div>

                        {
                          flavor.allergens.length > 0 ? (
                            <div class="detail-section">
                              <h3>{copy.fullAllergensHeading}</h3>
                              <ul class="detail-allergen-list">
                                {flavor.allergens.map((allergen) => {
                                  const info = allergenInfo[allergen.key];
                                  return (
                                    <li class:list={["detail-allergen", allergen.presence]}>
                                      <span class="allergen-icon" aria-hidden="true">
                                        <Icon name={info.icon} />
                                      </span>
                                      <span>
                                        <strong>{info.label[locale]}</strong>
                                        <small>
                                          {allergenPresenceLabels[allergen.presence][locale]}
                                          {allergen.note ? ` · ${allergen.note[locale]}` : ""}
                                        </small>
                                      </span>
                                    </li>
                                  );
                                })}
                              </ul>
                            </div>
                          ) : null
                        }
                      </div>
                    </div>
                  </div>
                </div>
              </dialog>
            </article>
          ))
        }
      </section>
    </main>

    <footer class="site-footer">
      <p>LaB Laboratorio del Gelato · Praiano</p>
      <p>{copy.footerStatus}</p>
    </footer>

    <script>
      const tabs = document.querySelectorAll("[data-filter]");
      const cards = document.querySelectorAll("[data-category]");
      const search = document.querySelector<HTMLInputElement>(".search-field input");
      let activeFilter = "all";

      const closeDialog = (dialog: HTMLDialogElement | null) => {
        if (!dialog?.open) {
          return;
        }

        if (typeof dialog.close === "function") {
          dialog.close();
        } else {
          dialog.removeAttribute("open");
        }
      };

      const updateCards = () => {
        const query = search?.value.trim().toLocaleLowerCase(document.documentElement.lang || "it") ?? "";

        cards.forEach((card) => {
          const matchesCategory = activeFilter === "all" || card.getAttribute("data-category") === activeFilter;
          const matchesSearch = !query || card.getAttribute("data-search")?.includes(query);
          const isVisible = Boolean(matchesCategory && matchesSearch);

          card.classList.toggle("is-hidden", !isVisible);
          if (!isVisible) {
            closeDialog(card.querySelector<HTMLDialogElement>(".flavor-dialog"));
          }
        });
      };

      tabs.forEach((tab) => {
        tab.addEventListener("click", () => {
          activeFilter = tab.getAttribute("data-filter") ?? "all";

          tabs.forEach((item) => {
            const active = item === tab;
            item.classList.toggle("active", active);
            item.setAttribute("aria-pressed", active ? "true" : "false");
          });

          updateCards();
        });
      });

      search?.addEventListener("input", updateCards);

      cards.forEach((card) => {
        const trigger = card.querySelector<HTMLButtonElement>("[data-dialog-trigger]");
        const dialogId = trigger?.getAttribute("aria-controls");
        const dialog = dialogId ? (document.getElementById(dialogId) as HTMLDialogElement | null) : null;
        const closeButton = dialog?.querySelector<HTMLButtonElement>("[data-dialog-close]");

        trigger?.addEventListener("click", () => {
          if (!dialog) {
            return;
          }

          const dialogImage = dialog.querySelector<HTMLImageElement>("[data-dialog-src]");
          if (dialogImage && !dialogImage.src) {
            dialogImage.src = dialogImage.dataset.dialogSrc ?? "";
          }

          if (typeof dialog.showModal === "function") {
            dialog.showModal();
          } else {
            dialog.setAttribute("open", "");
          }
        });

        closeButton?.addEventListener("click", () => closeDialog(dialog));

        dialog?.addEventListener("click", (event) => {
          if (event.target === dialog) {
            closeDialog(dialog);
          }
        });
      });
    </script>
  </body>
</html>
